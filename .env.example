# JWT (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-key-32chars

# Stripe
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# OAuth (optional in local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=barkwalk
S3_SECRET_KEY=barkwalksecret
S3_BUCKET=barkwalk-docs
S3_REGION=eu-west-3

# Media URL HMAC signing (local default is set in application.yml)
STORAGE_SIGNING_SECRET=barkwalk-dev-media-signing-secret-change-me
# Optional local disk root for uploads
# STORAGE_LOCAL_PATH=./data/uploads

# Cartes (frontend) — optionnel. Sans clé : OpenFreeMap.
# Si besoin de MapTiler : coller la clé dans frontend/src/environments/environment.ts
# MAPTILER_API_KEY=

# Mail — Brevo (API prioritaire) ou SMTP Brevo
MAIL_ENABLED=true
MAIL_FROM=noreply@votredomaine.fr
BREVO_API_KEY=xkeysib-xxxxxxxx
# Optionnel si vous préférez SMTP au lieu de l'API :
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
