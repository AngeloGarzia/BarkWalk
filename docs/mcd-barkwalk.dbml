// BarkWalk MCD/MLD post étapes 1–5 — https://dbdiagram.io
// R4: annulation tardive comptée = org threshold + membership quota

Table City {
  id bigint [pk, increment]
  insee_code varchar(5) [not null]
  postal_code varchar(5) [not null]
  name varchar(120) [not null]
  department varchar(3) [not null]
  region varchar(100) [not null]
  lat double
  lng double
  active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Zone {
  id bigint [pk, increment]
  city_id bigint [not null, ref: > City.id]
  name varchar(120) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table User {
  id bigint [pk, increment]
  public_id uuid [unique, not null]
  email varchar(255) [not null, note: 'unique lower(email)']
  password_hash varchar(255)
  password_algo varchar(40) [not null, note: 'BCRYPT|ARGON2ID']
  email_verified boolean [not null]
  enabled boolean [not null]
  deleted boolean [not null]
  deleted_at timestamptz
  anonymized_at timestamptz
  failed_login_attempts int [not null]
  locked_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table UserRole {
  user_id bigint [not null, ref: > User.id]
  role varchar(40) [not null]
  created_at timestamptz [not null]
  indexes { (user_id, role) [pk] }
}

Table RefreshToken {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > User.id]
  token_hash varchar(128) [unique, not null]
  family_id uuid [not null]
  replaced_by_token_id bigint
  reused_at timestamptz
  expires_at timestamptz [not null]
  revoked boolean [not null]
  created_at timestamptz [not null]
}

Table Profile {
  user_id bigint [pk, ref: - User.id]
  first_name varchar(80) [not null]
  last_name varchar(80) [not null]
  phone varchar(30)
  bio varchar(500)
  city_id bigint [ref: > City.id]
  zone_id bigint [ref: > Zone.id]
  community_org_status varchar(30) [not null, note: 'NONE|ELIGIBLE|ACTIVE|REVOKED']
  completed_walks_count int [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table CommunityOrgStatusHistory {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > User.id]
  from_status varchar(30)
  to_status varchar(30) [not null]
  changed_by bigint [ref: > User.id]
  reason text
  automatic boolean [not null]
  created_at timestamptz [not null]
}

Table Dog {
  id bigint [pk, increment]
  public_id uuid [unique, not null]
  owner_id bigint [not null, ref: > User.id]
  name varchar(100) [not null]
  breed varchar(100) [not null]
  sex varchar(10) [not null]
  size_category varchar(20) [not null]
  energy_level varchar(20) [not null]
  sociability_dogs varchar(20) [not null]
  sociability_humans varchar(20) [not null]
  danger_category varchar(5)
  dossier_status varchar(30) [not null]
  validated_by bigint [ref: > User.id]
  validated_at timestamptz
  refusal_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table DogDocument {
  id bigint [pk, increment]
  dog_id bigint [not null, ref: > Dog.id]
  doc_type varchar(40) [not null]
  storage_key varchar(255) [not null]
  expires_at date
  status varchar(30) [not null]
  validated_by bigint [ref: > User.id]
  validated_at timestamptz
  refusal_reason text
  reminder_j30_sent_at timestamptz
  reminder_j7_sent_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table MembershipPlan {
  id bigint [pk, increment]
  code varchar(40) [unique, not null]
  name varchar(120) [not null]
  price_cents int [not null]
  interval_unit varchar(20) [not null]
  active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Membership {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > User.id]
  plan_id bigint [not null, ref: > MembershipPlan.id]
  status varchar(30) [not null]
  current_period_start timestamptz
  current_period_end timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table WalkerProfile {
  id bigint [pk, increment]
  user_id bigint [unique, not null, ref: > User.id]
  walker_type varchar(20) [not null]
  status varchar(30) [not null]
  siret varchar(14)
  stripe_connect_account varchar(120)
  average_rating decimal(3,2)
  ratings_count int [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table WalkerDocument {
  id bigint [pk, increment]
  walker_id bigint [not null, ref: > WalkerProfile.id]
  doc_type varchar(40) [not null]
  storage_key varchar(255) [not null]
  expires_at date
  status varchar(30) [not null]
  validated_by bigint [ref: > User.id]
  validated_at timestamptz
  reminder_j30_sent_at timestamptz
  reminder_j7_sent_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table MeetingPoint {
  id bigint [pk, increment]
  public_id uuid [unique, not null]
  city_id bigint [not null, ref: > City.id]
  name varchar(120) [not null]
  address varchar(255) [not null]
  lat double [not null]
  lng double [not null]
  active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Walk {
  id bigint [pk, increment]
  public_id uuid [unique, not null]
  city_id bigint [not null, ref: > City.id]
  meeting_point_id bigint [not null, ref: > MeetingPoint.id]
  walk_type varchar(30) [not null, note: 'STAFF_GUIDED|COMMUNITY']
  title varchar(160) [not null]
  starts_at timestamptz [not null]
  duration_minutes int [not null]
  capacity int [not null]
  price_cents int [not null]
  non_member_price_cents int
  walker_id bigint [ref: > WalkerProfile.id]
  organizer_user_id bigint [ref: > User.id]
  status varchar(30) [not null]
  accepted_sizes text[] [not null]
  accepted_energy text[] [not null]
  cancelled_by_user_id bigint [ref: > User.id]
  cancellation_reason text
  recurrence_rule_id bigint
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table WalkRecurrenceRule {
  id bigint [pk, increment]
  template_walk_id bigint [not null, ref: > Walk.id]
  cron_expression varchar(80) [not null]
  until_date date
  active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Booking {
  id bigint [pk, increment]
  public_id uuid [unique, not null]
  walk_id bigint [not null, ref: > Walk.id]
  user_id bigint [not null, ref: > User.id]
  dog_id bigint [not null, ref: > Dog.id]
  status varchar(30) [not null, note: '…|CANCELLED_FREE|CANCELLED_LATE']
  payment_required boolean [not null]
  price_cents int [not null]
  is_trial boolean [not null]
  payment_expires_at timestamptz
  cancelled_by_user_id bigint [ref: > User.id]
  cancelled_by_role varchar(40)
  cancellation_reason text
  counts_toward_org_threshold boolean [not null]
  counts_toward_membership_quota boolean [not null]
  confirmed_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table WaitlistEntry {
  id bigint [pk, increment]
  walk_id bigint [not null, ref: > Walk.id]
  user_id bigint [not null, ref: > User.id]
  dog_id bigint [not null, ref: > Dog.id]
  position int [not null]
  status varchar(30) [not null]
  offered_at timestamptz
  offer_expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Attendance {
  id bigint [pk, increment]
  booking_id bigint [unique, not null, ref: - Booking.id]
  departure_status varchar(20)
  return_status varchar(20)
  recorded_by bigint [ref: > User.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table WalkReport {
  id bigint [pk, increment]
  walk_id bigint [unique, not null, ref: - Walk.id]
  author_id bigint [not null, ref: > User.id]
  actual_duration_minutes int
  route_done text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Incident {
  id bigint [pk, increment]
  walk_id bigint [not null, ref: > Walk.id]
  walk_report_id bigint [ref: > WalkReport.id]
  reported_by bigint [not null, ref: > User.id]
  incident_type varchar(40) [not null]
  severity varchar(20) [not null]
  description text [not null]
  status varchar(30) [not null]
  handled_by bigint [ref: > User.id]
  handled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Review {
  id bigint [pk, increment]
  walk_id bigint [not null, ref: > Walk.id]
  author_id bigint [not null, ref: > User.id]
  target_user_id bigint [not null, ref: > User.id]
  rating int [not null]
  review_type varchar(40) [not null]
  moderation_status varchar(20) [not null]
  comment text
  reply text
  replied_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Conversation {
  id bigint [pk, increment]
  public_id uuid [unique, not null]
  conversation_type varchar(40) [not null]
  walk_id bigint [ref: > Walk.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table ConversationMember {
  conversation_id bigint [not null, ref: > Conversation.id]
  user_id bigint [not null, ref: > User.id]
  last_read_at timestamptz
  last_notified_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (conversation_id, user_id) [pk] }
}

Table Message {
  id bigint [pk, increment]
  conversation_id bigint [not null, ref: > Conversation.id]
  sender_id bigint [not null, ref: > User.id]
  body text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  read_at timestamptz
}

Table Report {
  id bigint [pk, increment]
  reporter_id bigint [not null, ref: > User.id]
  target_type varchar(40) [not null]
  target_id bigint [not null]
  reason text [not null]
  status varchar(30) [not null]
  conversation_id bigint [ref: > Conversation.id]
  decided_by bigint [ref: > User.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Payment {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > User.id]
  booking_id bigint [ref: > Booking.id]
  membership_id bigint [ref: > Membership.id]
  amount_cents int [not null]
  commission_cents int [not null]
  payment_type varchar(40) [not null]
  status varchar(30) [not null]
  refund_amount_cents int
  refund_provider_id varchar(120)
  refunded_at timestamptz
  refund_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table Payout {
  id bigint [pk, increment]
  walker_id bigint [not null, ref: > WalkerProfile.id]
  payment_id bigint [not null, ref: > Payment.id]
  amount_cents int [not null]
  status varchar(30) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table WebhookEvent {
  id bigint [pk, increment]
  provider varchar(40) [not null]
  event_id varchar(120) [not null]
  signature_valid boolean [not null]
  payload_hash varchar(128)
  processing_status varchar(30) [not null]
  processed_at timestamptz [not null]
  created_at timestamptz [not null]
}

Table EmailTemplate {
  id bigint [pk, increment]
  code varchar(80) [unique, not null]
  name varchar(160) [not null]
  subject varchar(255) [not null]
  body_html text [not null]
  active boolean [not null]
  version varchar(20) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table AuditLog {
  id bigint [pk, increment]
  actor_id bigint [ref: > User.id]
  action varchar(80) [not null]
  entity_type varchar(60)
  entity_id bigint
  before_state jsonb
  after_state jsonb
  correlation_id uuid
  details text
  created_at timestamptz [not null]
  Note: 'append-only'
}

Table Setting {
  key varchar(80) [pk]
  value text [not null]
  description text
  updated_at timestamptz [not null]
}
